{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TicketBunker",
  "version": "0.2.21",
  "identifier": "dev.ticketbunker.desktop",
  "build": {
    "frontendDist": "../shell"
  },
  "app": {
    "windows": [],
    "security": {
      "capabilities": ["desktop-main"],
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
