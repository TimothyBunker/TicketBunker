{
  "name": "ticketbunker-desktop",
  "private": true,
  "overrides": { "monaco-editor": { "dompurify": "3.4.15" } },
  "version": "0.6.6",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:e2e": "node tests/standalone.e2e.mjs",
    "test:pipelines": "node tests/pipelines.e2e.mjs",
    "test:sharing": "node tests/sharing-campaign.e2e.mjs",
    "test:hardening": "node tests/hardening.e2e.mjs",
    "test:simulation": "node tests/workspace-simulation.e2e.mjs",
    "test:simulation:keyboard": "node tests/workspace-keyboard-simulation.e2e.mjs",
    "test:simulation:multiwindow": "node tests/workspace-multiwindow-simulation.e2e.mjs",
    "test:simulation:failures": "node tests/workspace-failure-simulation.e2e.mjs",
    "test:simulation:steady": "node tests/workspace-steady-simulation.e2e.mjs",
    "test:simulation:repeat": "node tests/workspace-simulation-repeat.mjs",
    "tauri": "tauri",
    "check": "npm run build && npm run test && cargo check --manifest-path src-tauri/Cargo.toml",
    "build:debug": "cargo build --manifest-path src-tauri/Cargo.toml"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "monaco-editor": "0.56.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  }
}
